{
    "name": "GameInputActions",
    "maps": [
        {
            "name": "UI",
            "id": "ui-action-map",
            "actions": [
                {
                    "name": "Point",
                    "type": "Value",
                    "expectedControlType": "Vector2",
                    "interactions": "",
                    "comment": "Mouse cursor position — used for drag ghost, tooltip positioning"
                },
                {
                    "name": "Click",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "Left mouse — pick up / place items, confirm craft"
                },
                {
                    "name": "RightClick",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "Right mouse — split stack (pick up half)"
                },
                {
                    "name": "MiddleClick",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "Middle mouse — quick drop single item (optional)"
                },
                {
                    "name": "Modifier",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "Shift — held during drag for half-stack, or during place for single-item"
                },
                {
                    "name": "ToggleInventory",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "Open / close inventory panel"
                },
                {
                    "name": "HotbarSelect",
                    "type": "Value",
                    "expectedControlType": "",
                    "interactions": "",
                    "comment": "Numeric keys 1-6 — value carries the slot index"
                },
                {
                    "name": "ScrollHotbar",
                    "type": "Value",
                    "expectedControlType": "Axis",
                    "interactions": "",
                    "comment": "Mouse scroll wheel — cycle hotbar selection"
                }
            ],
            "bindings": [
                { "action": "Point",           "path": "<Mouse>/position" },
                { "action": "Click",           "path": "<Mouse>/leftButton" },
                { "action": "RightClick",      "path": "<Mouse>/rightButton" },
                { "action": "MiddleClick",     "path": "<Mouse>/middleButton" },
                { "action": "Modifier",        "path": "<Keyboard>/leftShift" },
                { "action": "ToggleInventory", "path": "<Keyboard>/tab" },
                { "action": "ScrollHotbar",    "path": "<Mouse>/scroll/y" },

                { "action": "HotbarSelect", "path": "<Keyboard>/1", "interactions": "", "processors": "Scale(factor=0)" },
                { "action": "HotbarSelect", "path": "<Keyboard>/2", "interactions": "", "processors": "Scale(factor=1)" },
                { "action": "HotbarSelect", "path": "<Keyboard>/3", "interactions": "", "processors": "Scale(factor=2)" },
                { "action": "HotbarSelect", "path": "<Keyboard>/4", "interactions": "", "processors": "Scale(factor=3)" },
                { "action": "HotbarSelect", "path": "<Keyboard>/5", "interactions": "", "processors": "Scale(factor=4)" },
                { "action": "HotbarSelect", "path": "<Keyboard>/6", "interactions": "", "processors": "Scale(factor=5)" }
            ]
        },
        {
            "name": "Gameplay",
            "id": "gameplay-action-map",
            "actions": [
                {
                    "name": "Interact",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "E key — interact with crafting stations, pick up world items"
                },
                {
                    "name": "DropItem",
                    "type": "Button",
                    "expectedControlType": "Button",
                    "interactions": "",
                    "comment": "Q key — quick-drop currently held/selected hotbar item"
                }
            ],
            "bindings": [
                { "action": "Interact", "path": "<Keyboard>/e" },
                { "action": "DropItem", "path": "<Keyboard>/q" }
            ]
        }
    ]
}
